# Salin ke .env dan isi. Semua key di-parse pydantic-settings dengan
# extra="forbid" — key yang salah ketik bikin container GAGAL START, bukan
# diam-diam mati. Itu disengaja.
#
# Nested pakai delimiter ganda: DATABASE__URL -> settings.database.url
#
# --- Soal secret: .env sekarang, Vault nanti (lihat docs/SECRETS_ROTATION.md) ---
# SEKARANG (dev/pra-produksi): file ini SATU-SATUNYA sumber secret, dikontrol
# terpusat di sini. SECRETS_BACKEND=env (default).
#
# NANTI (produksi): SECRETS_BACKEND=vault. Vault sendiri udah ada di
# docker-compose.yml (service "vault", profile "vault") dan udah dites jalan
# -- tapi cti_core belum baca darinya. Itu kerjaan eksplisit di fase testing,
# bukan asumsi diam-diam. Saat itu terjadi, file ini menyusut jadi cuma dua
# baris di bawah; semua secret lain pindah ke Vault.
SECRETS_BACKEND=env                    # env (sekarang) | vault (produksi)
VAULT_ADDR=http://vault:8200           # dipakai HANYA kalau SECRETS_BACKEND=vault
VAULT_TOKEN=


# --- Umum ---
SERVICE_NAME=cti
ENVIRONMENT=dev                        # dev | staging | prod
LOG_LEVEL=INFO

# --- PostgreSQL ---
DATABASE__URL=postgresql+asyncpg://cti:cti@postgres:5432/cti
DATABASE__SYNC_URL=postgresql+psycopg://cti:cti@postgres:5432/cti
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=10

# --- Redis (broker Celery + rate limit + lock) ---
REDIS__URL=redis://redis:6379/0

# --- Auth ---
AUTH__JWT_SECRET=
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_EXPIRE_MIN=480
AUTH__SESSION_SECRET_KEY=

# --- OIDC (opsional) ---
OIDC__ENABLED=false
OIDC__CLIENT_ID=
OIDC__CLIENT_SECRET=
OIDC__DISCOVERY_URL=
OIDC__REDIRECT_URI=

# --- LLM ---
LLM__PROVIDER=openai                   # openai | deepseek | gemini
LLM__API_KEY=
LLM__URL=                              # kosongin = endpoint default provider; isi buat gateway custom (mis. 9router dev)
LLM__MODEL=gpt-4o
LLM__TIMEOUT_S=60
LLM__MAX_RETRIES=2
LLM__RATE_LIMIT=60/minute              # throttle spend global (sekarang gak ada)

# --- Telegram ---
# SATU token, SATU fungsi send(topic, msg). Menggantikan 14 fungsi yang
# masing-masing bikin Bot + event loop baru.
# Topic list = hasil port cti_enrich.routing.route() (Fase 5) -- global/apac/
# apt/apac_indo/data_breach_indo adalah cabang dispatcher `_send_alert` lama
# yang dulu implisit (if/elif di telegramAlert.py), sekarang eksplisit di sini.
TELEGRAM__BOT_TOKEN=
TELEGRAM__CHAT_ID=
# Topik -> thread_id (0 = channel utama tanpa thread). Topik yang dipakai kode TAPI gak ada di
# sini bikin pengiriman gagal KERAS (UnknownAlertTopic), bukan diam-diam salah channel.
# Padanan `thread_id_*` di config.yml lama: global/apt=group, vendor_report=report,
# tech_stack=techstack_related, tech_stack_unrelated=techstack_unrelated, notd=notd,
# debug=debug, darkweb=darkweb, github_poc=github_exploit, feed_twitter=tweet umum (dulu global/apac/apt). `library_advisory` (advisory NPM/PyPI/Go, dulu thread
# hardcoded di techstackLibrary/*.py), `logbook` (laporan logbook 2-mingguan), dan `top_ta`
# (laporan mingguan Top 5 threat actor berdasarkan pertumbuhan) topik baru: boleh diarahkan
# ke thread yang sama dengan topik lain.
TELEGRAM__THREAD_IDS={"global":0,"apac":0,"apac_indo":0,"apt":0,"ot":0,"zero_day":0,"data_breach":0,"data_breach_indo":0,"vendor_report":0,"tech_stack":0,"tech_stack_unrelated":0,"best_practice":0,"darkweb":0,"pir":0,"scraper_health":0,"notd":0,"debug":0,"library_advisory":0,"logbook":0,"top_ta":0,"github_poc":0,"feed_twitter":0,"cve_new":0}

# --- Email (Microsoft Graph) ---
GRAPH__TENANT_ID=
GRAPH__CLIENT_ID=
GRAPH__CLIENT_SECRET=
GRAPH__SENDER=
# GRAPH__CC: beberapa alamat dipisah koma ATAU titik koma, mis. a@x.com,b@x.com atau a@x.com;b@x.com
# dulu hardcoded di app/config.py -- isi di sini sekarang
GRAPH__CC=

# --- API eksternal ---
NVD__API_KEY=
GITHUB__TOKEN=
TWITTER__API_KEY=                      # twitterapi.io -- sumber Twitter DEFAULT semua scraper Twitter
# API resmi X (pay-per-use), sumber CADANGAN -- twitterapi.io tetap yang UTAMA dan dipakai selama
# masih bisa; pindah ke sini HANYA kalau twitterapi.io memang tidak bisa. Dipilih PER-SCRAPER lewat control plane
# (/scrapers -> detail -> "Sumber data Twitter/X"). Cuma bearer token; consumer/access key
# TIDAK dipakai. SATU underscore antara BEARER dan TOKEN (`__` = pemisah nesting).
# Tiap tweet yang dibaca ditagih (~$0,005) -- pasang batas belanja di X Developer Console.
X__BEARER_TOKEN=
OTX__API_KEY=
# Reputasi IOC (ROADMAP #4). Kosong = provider mati. AbuseIPDB gratis 1000 cek/hari; API publik
# VirusTotal DILARANG untuk pemakaian komersial -- isi hanya dengan plan yang lisensinya mengizinkan.
# Jatah per jam (opsional): ABUSEIPDB__RATE=40/hour, VIRUSTOTAL__RATE=20/hour, OTX__RATE=300/hour.
ABUSEIPDB__API_KEY=
VIRUSTOTAL__API_KEY=

# --- Scraper framework ---
SCRAPER__DEFAULT_RATE_LIMIT=20/minute
SCRAPER__DEFAULT_TIMEOUT_S=30
SCRAPER__DEDUP_TTL_DAYS=180
SCRAPER__COLD_START_MAX_ITEMS=5        # run pertama scraper baru: batasi item.
                                       # Tanpa ini, DB kosong + 206 scraper =
                                       # seluruh isi feed masuk sekaligus.
SCRAPER__ENRICH_QUEUE_MAX_DEPTH=2000   # guard backpressure

# --- Worker: 5 loop Celery beat (Fase 7.8) ---
WORKER__PIR_P1_ALERT_INTERVAL_MIN=5
WORKER__PIR_ALERT_INTERVAL_MIN=15
WORKER__ATTACK_SYNC_INTERVAL_DAYS=7
WORKER__BEAT_LOCK_TTL_S=30             # lock singleton beat (python -m cti_worker.beat_main);
                                       # leader mati = standby ambil alih <= segini detik
# Baris di bawah SENGAJA di-comment: field ini punya default berarti di kode
# (`cti_core.config.WorkerSettings`). Set KOSONG (`KEY=`) di .env BUKAN "pakai default" --
# pydantic-settings memakainya sebagai string kosong beneran. Uncomment + isi hanya kalau
# nilainya mau BEDA dari default di bawah.
# WORKER__SCRAPER_ITEM_RETENTION_DAYS=30       # Fase 9 -- umur baris scraper_items sebelum di-purge
# WORKER__SCRAPER_HEALTH_SWEEP_INTERVAL_MIN=30 # tiap berapa menit scraper.health_digest jalan
# Fase 10.E -- zona waktu laporan periodik (jam UTC+N; 7 = WIB). Job Rundeck lama jalan di jam
# LOKAL server, beat berjalan UTC: offset ini menerjemahkan jam laporan ke cron UTC. Set 0 kalau
# server produksi lama ternyata berjalan di UTC (cek `date` di server lama sebelum isi ini).
# WORKER__REPORT_UTC_OFFSET_HOURS=7
# WORKER__NEWS_OF_THE_DAY_MAX_TITLES=400
# WORKER__LOGBOOK_INTERVAL_DAYS=14
# WORKER__LOGBOOK_PREPARER_NAME=Jane Doe
# WORKER__LOGBOOK_PREPARER_TITLE=Threat Intelligence
# WORKER__LOGBOOK_APPROVER_NAME=John Doe
# WORKER__LOGBOOK_APPROVER_TITLE=Threat Intelligence, Lead

# --- Mirror CVE (ROADMAP #19, docs/CVE_CATALOG_DESIGN.md) ---
# MATI sampai dinyalakan sengaja (dev dulu, mode bayangan). Tugas cve.mirror_sync (tiap 5 menit) dan
# cve.mirror_purge (harian) tetap terjadwal, tapi langsung kembali bila false. Butuh restart worker.
CVE_MIRROR__ENABLED=false
# Apa yang dilakukan ingest dengan record baru: off (hanya mirror) | shadow (tulis cve_promotion_shadow
# untuk dibandingkan dengan new_cve; cve_tracker tidak disentuh) | live (tulis cve_tracker + ringkasan
# Telegram). Jangan live sebelum perbandingan bayangan ditinjau.
# CVE_MIRROR__PROMOTE=off
# Saat PROMOTE=live, scraper new_cve lama DITANGGUHKAN (beat tidak menjadwalkannya, health = disabled).
# true = biarkan jalan berdampingan (tumpang tindih / cadangan). Rollback: PROMOTE=off + restart.
# CVE_MIRROR__KEEP_LEGACY_NEW_CVE=false
# CVE_MIRROR__MAX_FILES_PER_RUN=3000   # batas unduhan record per siklus
# CVE_MIRROR__REQUEST_TIMEOUT_S=30

# --- Web ---
CORS_ORIGINS=http://localhost:3000
API_BASE_URL=http://api:8000

# Template `.env` PRODUKSI (Fase 10.F). Beda dari `.env.example` (yang berorientasi dev/lokal):
# file ini menandai tiap secret dengan status rotasi dan ngasih nilai default yang UDAH DIPUTUSKAN
# buat produksi (WIB, 22 topik Telegram, dst) -- bukan cuma placeholder kosong.
#
# CARA PAKAI:
#   1. cp .env.prod.template .env          (di host produksi, BUKAN di laptop/staging)
#   2. Isi semua baris yang ditandai [ ] ROTASI di bawah -- silang jadi [x] begitu diisi.
#      Nilai secret JANGAN pernah ditempel ke chat/tiket/log. Isi langsung di editor di server.
#   3. chmod 600 .env
#   4. python3 tools/ops/check_secrets.py --env-file .env   (probe live: LLM/Telegram/NVD/GitHub/
#      twitterapi.io/X -- lihat docs/CUTOVER_RUNBOOK.md 2.2). Ini BUKAN pengganti langkah 2 --
#      dia baru bisa jalan SETELAH file ini terisi, dan cuma menangkap secret yang salah/kadaluwarsa,
#      bukan yang lupa diisi (itu bikin container gagal start duluan, lihat catatan `extra="forbid"`
#      di `.env.example`).
#
# JANGAN taruh di sini: variabel level compose (`BIND_ADDR`, `*_PORT`, `POSTGRES_*`, `CTI_TAG`,
# `NGINX_*`, `TRUSTED_PROXY_HOPS`) -- itu di `docker/stack.env` (`cp docker/stack.env.example
# docker/stack.env`), file terpisah. Campur keduanya = container gagal start (`extra="forbid"`).
#
# Daftar 12 secret yang WAJIB dirotasi sebelum file ini dianggap "siap produksi":
# docs/SECRETS_ROTATION.md. Nomor [R#] di komentar tiap baris di bawah merujuk ke tabel di sana.

SECRETS_BACKEND=env                    # env sekarang; vault BELUM diintegrasikan cti_core (lihat SECRETS_ROTATION.md)
VAULT_ADDR=http://vault:8200
VAULT_TOKEN=

# --- Umum ---
SERVICE_NAME=cti
ENVIRONMENT=prod
LOG_LEVEL=INFO

# --- PostgreSQL --- (password ada di docker/stack.env, HARUS SAMA dgn di URL bawah)
DATABASE__URL=postgresql+asyncpg://cti:GANTI_INI@postgres:5432/cti
DATABASE__SYNC_URL=postgresql+psycopg://cti:GANTI_INI@postgres:5432/cti
DATABASE__POOL_SIZE=20
DATABASE__MAX_OVERFLOW=10

# --- Redis ---
REDIS__URL=redis://redis:6379/0

# --- Auth ---
# [ ] ROTASI [R-baru] AUTH__JWT_SECRET      -- generate baru: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__JWT_SECRET=
AUTH__JWT_ALGORITHM=HS256
AUTH__JWT_EXPIRE_MIN=480
# [ ] ROTASI [R-baru] AUTH__SESSION_SECRET_KEY -- generate baru dengan cara yang sama, JANGAN sama dengan JWT_SECRET
AUTH__SESSION_SECRET_KEY=

# --- OIDC (opsional, belum dipakai -- lihat SECRETS_ROTATION.md) ---
OIDC__ENABLED=false
OIDC__CLIENT_ID=
OIDC__CLIENT_SECRET=
OIDC__DISCOVERY_URL=
OIDC__REDIRECT_URI=

# --- LLM ---
# [ ] ROTASI [R-baru] LLM__API_KEY -- kunci produksi (BUKAN kunci dev/staging yang sudah pernah
#     dipakai di sesi rehearsal -- kunci itu sudah "terekspos" ke proses uji, anggap perlu diganti)
LLM__PROVIDER=openai
LLM__API_KEY=
LLM__URL=
LLM__MODEL=gpt-4o
LLM__TIMEOUT_S=60
LLM__MAX_RETRIES=2
LLM__RATE_LIMIT=60/minute

# --- Telegram ---
# [ ] ROTASI [R2, R12] TELEGRAM__BOT_TOKEN -- HARUS bot BARU (bukan bot dev/staging; #R12 nemu
#     token techstackLibrary yang tercampur sama bot #R2 -- pastikan dua-duanya sudah di-revoke).
TELEGRAM__BOT_TOKEN=
# [ ] ROTASI [R3] TELEGRAM__CHAT_ID -- chat ID channel PRODUKSI (bukan chat tes staging)
TELEGRAM__CHAT_ID=
# WAJIB semua 22 topik ada -- topik dipakai kode tapi tak ada di sini = UnknownAlertTopic (gagal
# keras, bukan diam-diam salah channel). Isi thread_id masing-masing. 0 = TIDAK pakai thread: pesan
# masuk chat utama. Kalau SEMUA tetap 0, semua topik menumpuk di satu tempat (`check_secrets.py` memberi
# NOTE soal ini). thread_id sebuah topik: di Telegram klik kanan topiknya > Copy Link, angka terakhir pada
# https://t.me/c/<chat>/<thread_id> -- dan chat-nya harus grup forum (Topics aktif).
TELEGRAM__THREAD_IDS={"global":0,"apac":0,"apac_indo":0,"apt":0,"ot":0,"zero_day":0,"data_breach":0,"data_breach_indo":0,"vendor_report":0,"tech_stack":0,"tech_stack_unrelated":0,"best_practice":0,"darkweb":0,"pir":0,"scraper_health":0,"notd":0,"debug":0,"library_advisory":0,"logbook":0,"top_ta":0,"github_poc":0,"feed_twitter":0,"cve_new":0}

# --- Email (Microsoft Graph) ---
# [ ] ROTASI [R-baru] GRAPH__CLIENT_SECRET -- kredensial app registration PRODUKSI
GRAPH__TENANT_ID=
GRAPH__CLIENT_ID=
GRAPH__CLIENT_SECRET=
GRAPH__SENDER=
# GRAPH__CC: beberapa alamat dipisah koma ATAU titik koma, mis. a@x.com,b@x.com atau a@x.com;b@x.com
# [R9] dulu hardcoded di app/config.py -- isi di sini sekarang
GRAPH__CC=

# --- API eksternal ---
# [ ] ROTASI [R-baru] NVD__API_KEY -- key produksi (naikkan dari 5 ke 50 req/30dtk, lihat new_cve.py)
NVD__API_KEY=
# [ ] ROTASI [R-baru] GITHUB__TOKEN
GITHUB__TOKEN=
# [ ] ROTASI [R-baru] TWITTER__API_KEY -- twitterapi.io, sumber Twitter UTAMA (dipaksa duluan;
#     lihat docs/CUTOVER_RUNBOOK.md bagian 8). Tier: lihat catatan monitor_x di ROADMAP/PROGRESS --
#     free tier dipertahankan dengan pacing, BUKAN alasan wajib upgrade tier.
TWITTER__API_KEY=
# [ ] ROTASI [R-baru] X__BEARER_TOKEN -- API resmi X, CADANGAN (manual per-scraper). Boleh dikosongkan
#     kalau cadangan belum mau disiapkan -- SATU underscore antara BEARER dan TOKEN.
#     Pay-per-use: pasang batas belanja di X Developer Console SEBELUM mengisi ini.
X__BEARER_TOKEN=
OTX__API_KEY=

# --- Scraper framework ---
SCRAPER__DEFAULT_RATE_LIMIT=20/minute
SCRAPER__DEFAULT_TIMEOUT_S=30
SCRAPER__DEDUP_TTL_DAYS=180
SCRAPER__COLD_START_MAX_ITEMS=5
SCRAPER__ENRICH_QUEUE_MAX_DEPTH=2000

# --- Mirror CVE (ROADMAP #19): MATI sampai dinyalakan sengaja; butuh restart worker ---
CVE_MIRROR__ENABLED=false
CVE_MIRROR__PROMOTE=off
CVE_MIRROR__KEEP_LEGACY_NEW_CVE=false

# --- Worker ---
WORKER__PIR_P1_ALERT_INTERVAL_MIN=5
WORKER__PIR_ALERT_INTERVAL_MIN=15
WORKER__ATTACK_SYNC_INTERVAL_DAYS=7
WORKER__BEAT_LOCK_TTL_S=30
WORKER__SCRAPER_ITEM_RETENTION_DAYS=30
WORKER__SCRAPER_HEALTH_SWEEP_INTERVAL_MIN=30
# WIB (keputusan user 2026-09-26). Set 0 kalau server Rundeck lama ternyata jalan di UTC --
# cek dengan `date` di server lama SEBELUM cutover, jangan asumsi.
WORKER__REPORT_UTC_OFFSET_HOURS=7
WORKER__NEWS_OF_THE_DAY_MAX_TITLES=400
WORKER__LOGBOOK_INTERVAL_DAYS=14
WORKER__LOGBOOK_PREPARER_NAME=Dyah Retno Palupi
WORKER__LOGBOOK_PREPARER_TITLE=Threat Intel
WORKER__LOGBOOK_APPROVER_NAME=Ikbal Mahendra
WORKER__LOGBOOK_APPROVER_TITLE=Infrastructure Security, Lead

# --- Web ---
# Domain publik yang dipakai orang membuka platform -- HARUS cocok dengan NGINX_TLS_HOSTS di
# docker/stack.env (dan pakai https://, bukan http://).
CORS_ORIGINS=https://GANTI_INI.example.internal
API_BASE_URL=http://api:8000           # internal ke jaringan compose -- JANGAN diganti ke domain publik
